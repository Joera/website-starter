<header class="site-header">
    <details class="site-header__menu">
        <summary aria-label="Toggle navigation">
            <svg viewBox="0 0 10 9" width="10" height="9" aria-hidden="true"><path d="M.5 1h9M.5 8h9M.5 4.5h9" stroke="currentColor" stroke-linecap="round"/></svg>
        </summary>
        <nav class="site-header__menu-panel" aria-label="Contents">
            {{> docs-nav}}
        </nav>
    </details>

    {{!-- The mark is the entry point of the documentation: the first chapter.
          The tagline is its own span so the small-screen header can drop it and
          keep the mark on one line next to the actions. --}}
    {{#each (slice collections.chapters 0 1)}}
    <a class="site-header__mark" href="/"><span class="site-header__wordmark">Polyphony</span><span class="site-header__tagline">: a publishing protocol for independent authors and collective publications</span></a>
    {{/each}}

    {{!-- Site-wide links, right aligned, same targets as the footer. Icon only,
          so each anchor carries its label in aria-label. The SVGs are vendored
          Phosphor partials — plain <svg>, no JS (see icon-*.handlebars). --}}
    <div class="site-header__actions">
        <span class="site-header__divider" aria-hidden="true"></span>
        <a href="https://github.com/Incredibly-Neutral/Soul2Soul" target="_blank" rel="noopener" aria-label="GitHub">{{> icon-github}}</a>
        <a href="/llms.txt" target="_blank" rel="noopener" aria-label="Agents (llms.txt)">{{> icon-agents}}</a>
        <a href="/assets/polyphony-white-paper.pdf" target="_blank" rel="noopener" aria-label="Download (PDF)">{{> icon-download}}</a>
    </div>

</header>
