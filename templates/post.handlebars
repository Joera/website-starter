<!DOCTYPE html>
<html lang="{{language}}">
{{> head }}

<body id="post">
    {{> header}}
    <main>
        
        <section class="container small_container">
          
            <article class="post" id="{{this.id}}" author="{{author}}">  
                
                <h2>{{title}}</h2> 
                <div class="author">{{author}}</div> 
                <span class='date'>{{formatDate creationDate}}</span>
                
                {{{extract_images content}}}    
                pnpm sas      
            </article>
        
        </section>
    </main>
</body>
</html>